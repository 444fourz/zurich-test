# Backend configuration
# Copy this file to backend/.env and run the backend from the repository root,
# because the .env path and the database path below are relative to it.

# Host and port the API listens on
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed frontend origins (no spaces between entries).
# Must include the origin the Vite dev server runs on (port 5173 by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to the SQLite database, relative to the repository root
DATABASE_PATH=backend/underwriting.db

# Key used to sign login tokens. Uncomment and set your own value, which you can
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is created on each start and everyone is logged out.
# SECRET_KEY=replace-me-with-a-long-random-string

# How long a login lasts, in minutes
ACCESS_TOKEN_MINUTES=60
